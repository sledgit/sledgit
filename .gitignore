# dependencies and build output
node_modules/
.next/
site/out/
*.tsbuildinfo
contracts/target/
target/
__pycache__/
venv/
.venv/

# third-party clone used by the TEE spike (github.com/nearai/nearai-cloud-verifier); fetch it again to run the spike
spikes/near-ai-tee/verifier/

# public market data, re-downloaded and checksum-verified by spikes/backtest/get_archive.sh
spikes/backtest/data/

# secrets never live in the repo; spikes read them from ~/.config/sledgit/
.env
.env.*
*.env
*.key
*.pem
# NEAR key files are JSON: never commit them
*key*.json
*.credentials.json
.near-credentials/
# more key and credential file names (audits/phase-1-review.md P1-13); near-cli saves keys as <account>.json
credentials.json
secrets.json
*secret*.json
wallet.json
*.seed
id_ed25519*
id_rsa*
.npmrc
*.testnet.json
*.near.json

# test reports
tests/out/
.DS_Store
tests/.run.lock/

# generated by site/scripts/agent-files.mjs from agent/SKILL.md
site/public/skill.md
site/public/llms-full.txt

# legacy testnet results naming a retired vault account; kept locally, not committed (audits/phase-1-review.md P1-14)
deploy/testnet/local-legacy/

# generated by site/scripts/league-files.mjs from deploy/<network>/league/
site/src/data/league-testnet.json
site/src/data/league-mainnet.json
site/public/league/

# Filled Season 1 plans carry real account ids; keep them local.
deploy/mainnet/season1.json
deploy/testnet/*.local.json

# Design iterations and render scripts: kept locally, not published.
brand-gen/
